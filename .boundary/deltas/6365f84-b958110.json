      ]
    },
    {
      "description": "Responsive line-oriented tables over safe structured text",
      "documentation": [
        "https://github.com/mothx9/replai/blob/b9581102220364b94d2bcdef49f602308d24e6c9/docs/presentation.md#structured-documents-and-semantic-ownership"
      ],
      "evidence": [
        "https://github.com/mothx9/replai/actions/runs/34251543122"
      ],
      "guarantees": [
        "Unicode cell alignment, bounded column shrinking and multiline cells",
        "Narrow layouts stack records; no horizontal scrolling or hidden content"
      ],
      "id": "presentation.table",
      "maturity": "experimental",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "surfaces": [
