{
  "capability_contracts": [
    {
      "description": "Optional bounded C semantic presentation extension alongside unchanged ABI 1",
      "documentation": [
        "https://github.com/mothx9/replai/blob/eb246d3fd81353fc3be27c8924ee2321067530bf/docs/engineering/c-presentation.md"
      ],
      "evidence": [
        "https://github.com/mothx9/replai/blob/eb246d3fd81353fc3be27c8924ee2321067530bf/docs/engineering/c-presentation.md"
      ],
      "guarantees": [
        "Explicit extension size/version/reserved-zero records; borrowed input, caller-owned output",
        "Existing ABI 1 layouts and meanings unchanged; no private Rust layouts or allocator ownership escape"
      ],
      "id": "abi.c.presentation_v1",
      "maturity": "experimental",
      "platforms": [
        "linux"
      ],
      "surfaces": [
        "c-presentation-v1"
      ]
    },
    {
      "description": "Opt-in logical-line and fragment encoding for terminal-owned wrapping and emulator-owned scrollback reflow",
      "documentation": [
        "https://github.com/mothx9/replai/blob/40f9977051f671dcebad07bcaebb8a21405ebed7/docs/presentation.md#flow-output-and-resize"
      ],
      "evidence": [
        "https://github.com/mothx9/replai/blob/a94265dae932d3033a59009814405b82dddc40b1/tests/document.rs",
        "https://github.com/mothx9/replai/blob/a94265dae932d3033a59009814405b82dddc40b1/tests/pty.rs",
        "https://github.com/mothx9/replai/blob/a94265dae932d3033a59009814405b82dddc40b1/tools/flow/check_reflow.cjs",
        "https://github.com/mothx9/replai/actions/runs/37213638790",
        "https://github.com/mothx9/replai/blob/40f9977051f671dcebad07bcaebb8a21405ebed7/docs/presentation.md#flow-output-and-resize"
      ],
      "guarantees": [
        "Text::render_flow preserves logical LF/TAB and adds no newline; no stored width or hard-wrap insertion",
        "Document flow uses logical prefixes and stacked label/value table records through the existing safe renderer",
        "Interaction::output_flow serializes output and restores the draft/cursor/revision on Linux/macOS; rejection precedes terminal output",
        "Existing fixed-width Rust rendering and C ABI 1/presentation extension 1 remain unchanged",
        "Hosts own stream serialization and resize delivery; no transcript replay, producer arbitration, word-wrap or universal emulator reflow promise",
        "Pinned xterm/headless observer qualifies retained scrollback, not reflow of the active cursor paragraph; Windows remains portable-core only"
      ],
      "id": "presentation.flow_output",
      "maturity": "experimental",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "surfaces": [
        "rust-native"
      ]
    }
  ],
