{
  "capability_contracts": [
    {
      "description": "Bounded generic prefix, common-prefix, fuzzy and one-level filesystem completion construction",
      "documentation": [
        "https://github.com/mothx9/replai/blob/db4dff1dd1bd9bd1b15ac953efe2c894c51ed2fd/docs/interaction.md#generic-completion-helpers"
      ],
      "evidence": [
        "https://github.com/mothx9/replai/actions/runs/34772036277",
        "https://github.com/mothx9/replai/actions/runs/34772036424",
        "https://github.com/mothx9/replai/blob/db4dff1dd1bd9bd1b15ac953efe2c894c51ed2fd/docs/engineering/completion-keymap-suggestion.md"
      ],
      "guarantees": [
        "Host supplies replacement context and candidate meaning; helpers own only explicitly selected generic matching",
        "Common prefixes end on extended-grapheme boundaries; fuzzy ties and filesystem results are deterministic",
        "Outputs are validated atomically against CompletionSet limits; path completion adds no shell quoting, expansion or lossy non-UTF-8 insertion"
      ],
      "id": "completion.helpers",
      "maturity": "experimental",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "surfaces": [
        "rust-native"
      ]
    },
    {
      "description": "Explicit bounded navigation and visible-window presentation for large completion sets",
      "documentation": [
        "https://github.com/mothx9/replai/blob/db4dff1dd1bd9bd1b15ac953efe2c894c51ed2fd/docs/interaction.md#large-completion-navigation"
      ],
      "evidence": [
        "https://github.com/mothx9/replai/actions/runs/34772036277",
        "https://github.com/mothx9/replai/actions/runs/34772036424",
        "https://github.com/mothx9/replai/blob/db4dff1dd1bd9bd1b15ac953efe2c894c51ed2fd/docs/engineering/completion-keymap-suggestion.md"
      ],
      "guarantees": [
        "Next/previous wrap; page movement clamps; first/last are direct and the selected index remains stable across resize",
        "Navigation is O(1), retains one CompletionSet plus small index state and does not clone candidate payload",
        "Sets through the 4096-candidate protocol maximum remain selectable in styled, plain and narrow terminal profiles"
      ],
      "id": "completion.large_sets",
      "maturity": "experimental",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "surfaces": [
        "rust-native"
      ]
    },
    {
      "description": "Bounded configurable mapping from portable normalized keys to public semantic interaction actions",
      "documentation": [
        "https://github.com/mothx9/replai/blob/db4dff1dd1bd9bd1b15ac953efe2c894c51ed2fd/docs/interaction.md#configurable-semantic-keymaps"
      ],
      "evidence": [
        "https://github.com/mothx9/replai/actions/runs/34772036277",
        "https://github.com/mothx9/replai/actions/runs/34772036424",
        "https://github.com/mothx9/replai/blob/db4dff1dd1bd9bd1b15ac953efe2c894c51ed2fd/docs/engineering/completion-keymap-suggestion.md"
      ],
      "guarantees": [
        "The decoder recognizes protocol input, KeyMap assigns policy and the Engine executes one public semantic Action path",
        "At most 128 sorted custom mappings; lookup is allocation-free O(log n), and configuration requires a closed Interaction",
        "Printable UTF-8 and bracketed paste never enter the configurable command domain; default compatibility bindings remain intact"
      ],
      "id": "editing.keymap",
      "maturity": "experimental",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "surfaces": [
        "rust-native"
      ]
    },
    {
      "description": "One bounded revision-bound acceptable autosuggestion distinct from display-only analysis hints",
      "documentation": [
        "https://github.com/mothx9/replai/blob/db4dff1dd1bd9bd1b15ac953efe2c894c51ed2fd/docs/interaction.md#revision-bound-autosuggestion"
      ],
      "evidence": [
        "https://github.com/mothx9/replai/actions/runs/34772036277",
        "https://github.com/mothx9/replai/actions/runs/34772036424",
        "https://github.com/mothx9/replai/blob/db4dff1dd1bd9bd1b15ac953efe2c894c51ed2fd/docs/engineering/completion-keymap-suggestion.md"
      ],
      "guarantees": [
        "A suggestion is non-canonical until explicit acceptance; obsolete revisions return Stale without state or terminal output",
        "Whole-suggestion acceptance is one atomic undoable edit with a fresh DraftRevision; dismissal preserves draft and revision",
        "Exactly one 4096-byte suffix suggestion is retained; history and static helpers remain host-fed and bounded",
        "History search, completion and diagnostics suppress suggestions; suggestions suppress hints, and current hidden surfaces may return when precedence ends"
      ],
      "id": "suggestion.autosuggest",
      "maturity": "experimental",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "surfaces": [
        "rust-native"
      ]
    }
  ],
