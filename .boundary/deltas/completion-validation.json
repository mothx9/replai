{
  "capability_contracts": [
    {
      "description": "Optional host-owned revision-bound submission validation",
      "documentation": [
        "https://github.com/mothx9/replai/blob/0abed4fa75a5684005c87df3bb36e2f997025d00/docs/interaction.md#validated-submission-and-multiline-navigation",
        "https://github.com/mothx9/replai/blob/0abed4fa75a5684005c87df3bb36e2f997025d00/docs/use-cases.md"
      ],
      "evidence": [
        "https://github.com/mothx9/replai/actions/runs/34494834221",
        "https://github.com/mothx9/replai/blob/0abed4fa75a5684005c87df3bb36e2f997025d00/docs/engineering/validation-multiline.md"
      ],
      "guarantees": [
        "Host grammar and scheduling remain external; Enter emits an immutable snapshot when validation is enabled",
        "Complete atomically submits exactly the requested current draft; Incomplete inserts LF; Invalid preserves text and shows bounded safe diagnostics",
        "Stale results cannot submit, edit or emit terminal bytes; successful decisions consume pending Enter authority",
        "32 diagnostics, 4096 bytes per message and 65536 aggregate bytes; grapheme-safe optional snapshot ranges",
        "Direct submission remains default; C ABI 1 cannot enable validation"
      ],
      "id": "analysis.validation",
      "maturity": "experimental",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "surfaces": [
        "rust-native"
      ]
    },
    {
      "description": "Externally scheduled input, opaque deadlines and resize over one engine",
      "documentation": [
        "https://github.com/mothx9/replai/blob/3c0b14162cd322017bb718b71cc4b433c6100476/docs/interaction.md"
      ],
      "evidence": [
        "https://github.com/mothx9/replai/actions/runs/34494834221",
        "https://github.com/mothx9/replai/blob/0abed4fa75a5684005c87df3bb36e2f997025d00/docs/engineering/validation-multiline.md"
      ],
      "guarantees": [
        "No periodic library wake when idle without a deadline; no blocking input-ready advancement",
        "Host owns event waiting and resize notification; output mutations remain serialized",
        "Deadline tokens reject early, stale and previous-session notifications",
        "Native Event adds opt-in SubmissionRequested; exhaustive Rust matches need an additional arm. Default runtime submission is unchanged."
      ],
      "id": "embedding.driven",
      "maturity": "experimental",
      "platforms": [
        "linux",
        "macos"
      ],
      "surfaces": [
        "rust-native"
      ]
    },
    {
      "description": "Explicit session compatibility over the common driver",
      "documentation": [
        "https://github.com/mothx9/replai/blob/3c0b14162cd322017bb718b71cc4b433c6100476/docs/interaction.md"
      ],
      "evidence": [
        "https://github.com/mothx9/replai/actions/runs/34494834221",
        "https://github.com/mothx9/replai/blob/0abed4fa75a5684005c87df3bb36e2f997025d00/docs/engineering/validation-multiline.md"
      ],
      "guarantees": [
        "Existing open/poll/completion/output/close behavior and bounded read-ahead remain available",
        "Compatibility polling retains bounded periodic resize observation; C ABI 1 unchanged",
        "Native Event adds opt-in SubmissionRequested; exhaustive Rust matches need an additional arm. Default runtime submission is unchanged."
      ],
      "id": "embedding.session",
      "maturity": "experimental",
      "platforms": [
        "linux",
        "macos"
      ],
      "surfaces": [
        "rust-native"
      ]
    },
    {
      "description": "Validated multiline navigation and safe diagnostic continuation surface",
      "documentation": [
        "https://github.com/mothx9/replai/blob/0abed4fa75a5684005c87df3bb36e2f997025d00/docs/interaction.md#validated-submission-and-multiline-navigation",
        "https://github.com/mothx9/replai/blob/0abed4fa75a5684005c87df3bb36e2f997025d00/docs/use-cases.md"
      ],
      "evidence": [
        "https://github.com/mothx9/replai/actions/runs/34494834221",
        "https://github.com/mothx9/replai/blob/0abed4fa75a5684005c87df3bb36e2f997025d00/docs/engineering/validation-multiline.md"
      ],
      "guarantees": [
        "Same prompt, width policy, viewport and renderer across Linux/macOS native interaction",
        "Opt-in Up/Down move through logical lines then history at boundaries; direct mode keeps existing history bindings",
        "Completion acceptance precedes validation; bracketed multiline paste remains one edit",
        "Revision changes invalidate diagnostics; resize and serialized output preserve exact draft/cursor and current explanations",
        "Bounded textual diagnostic markers remain understandable without styling; this is not general highlighting or a full-screen interface"
      ],
      "id": "presentation.multiline_ux",
      "maturity": "experimental",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "surfaces": [
        "rust-native"
      ]
    }
  ],
