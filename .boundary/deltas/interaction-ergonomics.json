{
  "capability_contracts": [
    {
      "description": "Bounded editor-owned single-register kill and yank mechanics",
      "documentation": [
        "https://github.com/mothx9/replai/blob/0e281321abe1d43af49bace6baed90a9a80f89aa/docs/interaction.md#daily-driver-editing-and-history-search"
      ],
      "evidence": [
        "https://github.com/mothx9/replai/actions/runs/34760786690",
        "https://github.com/mothx9/replai/blob/0e281321abe1d43af49bace6baed90a9a80f89aa/docs/engineering/interaction-ergonomics.md"
      ],
      "guarantees": [
        "Word and logical-line kills replace one bounded private register; it is not a system clipboard, application store or Readline kill ring",
        "Failed kill or yank preserves draft, cursor, revision, undo/redo and prior register; successful operations compose as canonical undoable transactions",
        "Register lifetime follows the retained Editor and can be explicitly cleared for future sensitive-input policy"
      ],
      "id": "editing.kill_yank",
      "maturity": "experimental",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "surfaces": [
        "rust-native"
      ]
    },
    {
      "description": "Bounded delta-based undo and redo with monotonic draft identity",
      "documentation": [
        "https://github.com/mothx9/replai/blob/0e281321abe1d43af49bace6baed90a9a80f89aa/docs/interaction.md#daily-driver-editing-and-history-search"
      ],
      "evidence": [
        "https://github.com/mothx9/replai/actions/runs/34760786690",
        "https://github.com/mothx9/replai/blob/0e281321abe1d43af49bace6baed90a9a80f89aa/docs/engineering/interaction-ergonomics.md"
      ],
      "guarantees": [
        "Undo restores content and cursor with a fresh DraftRevision; it never revives an old analysis identity",
        "Entry and payload bytes are explicitly bounded; ordinary local insertion retains a local delta rather than cloning the draft",
        "Contiguous typing and deletion grouping is bounded and deterministic; divergent editing clears redo while cursor-only navigation preserves it"
      ],
      "id": "editing.undo_redo",
      "maturity": "experimental",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "surfaces": [
        "rust-native"
      ]
    },
    {
      "description": "Locale-independent Unicode word movement and deletion over grapheme-safe boundaries",
      "documentation": [
        "https://github.com/mothx9/replai/blob/0e281321abe1d43af49bace6baed90a9a80f89aa/docs/interaction.md#daily-driver-editing-and-history-search"
      ],
      "evidence": [
        "https://github.com/mothx9/replai/actions/runs/34760786690",
        "https://github.com/mothx9/replai/blob/0e281321abe1d43af49bace6baed90a9a80f89aa/docs/engineering/interaction-ergonomics.md"
      ],
      "guarantees": [
        "UAX #29 default word boundaries are snapped to extended-grapheme boundaries across punctuation, whitespace, multiline and mixed Unicode text",
        "Movement is allocation-free; deletion is one bounded undoable canonical transaction and never splits a grapheme"
      ],
      "id": "editing.word_operations",
      "maturity": "experimental",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "surfaces": [
        "rust-native"
      ]
    },
    {
      "description": "Bounded literal reverse history search over admitted and host-provided entries",
      "documentation": [
        "https://github.com/mothx9/replai/blob/0e281321abe1d43af49bace6baed90a9a80f89aa/docs/interaction.md#daily-driver-editing-and-history-search"
      ],
      "evidence": [
        "https://github.com/mothx9/replai/actions/runs/34760786690",
        "https://github.com/mothx9/replai/blob/0e281321abe1d43af49bace6baed90a9a80f89aa/docs/engineering/interaction-ergonomics.md"
      ],
      "guarantees": [
        "Host owns persistence, I/O, admission, retention, privacy and encryption; REPLAI retains only one explicitly bounded immutable search view",
        "Search query and selected match are non-canonical; dismissal preserves exact draft identity and acceptance is one undoable replacement with a fresh revision",
        "Newest-first case-sensitive UTF-8 substring matching is duplicate-preserving and non-wrapping; provider failure and invalid text reject atomically",
        "Linux/macOS real PTY and native memory qualification; Windows portable model only"
      ],
      "id": "interaction.history_search",
      "maturity": "experimental",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "surfaces": [
        "rust-native"
      ]
    }
  ],
