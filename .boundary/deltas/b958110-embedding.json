{
  "capability_contracts": [
    {
      "description": "Retained blocking read with typed submission, editing interrupt and EOF",
      "documentation": [
        "https://github.com/mothx9/replai/blob/3c0b14162cd322017bb718b71cc4b433c6100476/docs/interaction.md"
      ],
      "evidence": [
        "https://github.com/mothx9/replai/actions/runs/34353630259"
      ],
      "guarantees": [
        "One engine and resource lifecycle; no host poll loop required",
        "History admission and application meaning remain host-owned; no completion discovery"
      ],
      "id": "embedding.blocking",
      "maturity": "experimental",
      "platforms": [
        "linux",
        "macos"
      ],
      "surfaces": [
        "rust-native"
      ]
    },
    {
      "description": "Externally scheduled input, opaque deadlines and resize over one engine",
      "documentation": [
        "https://github.com/mothx9/replai/blob/3c0b14162cd322017bb718b71cc4b433c6100476/docs/interaction.md"
      ],
      "evidence": [
        "https://github.com/mothx9/replai/actions/runs/34353630259"
      ],
      "guarantees": [
        "No periodic library wake when idle without a deadline; no blocking input-ready advancement",
        "Host owns event waiting and resize notification; output mutations remain serialized",
        "Deadline tokens reject early, stale and previous-session notifications"
      ],
      "id": "embedding.driven",
      "maturity": "experimental",
      "platforms": [
        "linux",
        "macos"
      ],
      "surfaces": [
        "rust-native"
      ]
    },
    {
      "description": "Borrowed native readiness with portable scheduling vocabulary",
      "documentation": [
        "https://github.com/mothx9/replai/blob/3c0b14162cd322017bb718b71cc4b433c6100476/docs/interaction.md"
      ],
      "evidence": [
        "https://github.com/mothx9/replai/actions/runs/34353630259"
      ],
      "guarantees": [
        "Linux/macOS input source is borrowed and cannot transfer resource/restoration ownership",
        "POSIX registration must end before close/reopen; generic wake types contain no descriptors"
      ],
      "id": "embedding.readiness",
      "maturity": "experimental",
      "platforms": [
        "linux",
        "macos"
      ],
      "surfaces": [
        "rust-native"
      ]
    },
    {
