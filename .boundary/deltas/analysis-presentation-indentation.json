      ],
      "guarantees": [
        "Same prompt, width policy, viewport and renderer across Linux/macOS native interaction",
        "Opt-in Up/Down move through logical lines then history at boundaries; direct mode keeps existing history bindings",
        "Completion acceptance precedes validation; bracketed multiline paste remains one edit",
        "Revision changes invalidate diagnostics; resize and serialized output preserve exact draft/cursor and current explanations",
        "Bounded textual diagnostic markers remain understandable without styling; this is not general highlighting or a full-screen interface",
        "Validated continuation-line ASCII whitespace prefixes consume Tab as one atomic space insertion to the next four-cell stop; the first line and positions after text still request completion; active menus retain Tab navigation",
        "Indentation capacity rejection preserves draft, revision and current analysis/diagnostics; direct submission, simple blocking and C ABI 1 retain prior Tab behavior"
      ],
      "id": "presentation.multiline_ux",
      "maturity": "experimental",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "surfaces": [
        "rust-native"
      ]
    }
