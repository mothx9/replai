    {
      "name": "replai_create",
      "doc": "Create one owned opaque handle. *out must initially be NULL. Failures leave it unchanged.",
      "params": [
        [
          "config",
          "*const ReplaiConfig"
        ],
        [
          "out",
          "*mut *mut Handle"
        ]
      ]
    },
    {
      "name": "replai_destroy",
      "doc": "Close and release *handle, then set it to NULL, including on cleanup error. NULL is invalid.",
      "params": [
        [
          "handle",
          "*mut *mut Handle"
        ]
      ]
    },
    {
      "name": "replai_prompt",
