          "handle",
          "*mut Handle"
        ]
      ]
    },
    {
      "name": "replai_poll",
      "doc": "Poll bounded ready input, waiting at most 100 ms. Stop at the first event; read-ahead remains with the handle across reopen. Validate event before consuming input.",
